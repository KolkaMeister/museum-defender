  BigSprite: {fileID: 21300000, guid: 9245b44b28c549d4cb5afbf4914db4ab, type: 3}
  Description: "\"\u0414\u0440\u0443\u0436\u0438\u043D\u0430 \u043A\u043D\u044F\u0437\u044F
    \u0434\u0435\u043B\u0438\u043B\u0430\u0441\u044C \u043D\u0430 \u0441\u0442\u0430\u0440\u0448\u0443\u044E
    (\u0431\u043E\u044F\u0440\u0435) \u0438 \u043C\u043B\u0430\u0434\u0448\u0443\u044E
    (\u043E\u0442\u0440\u043E\u043A\u0438, \u0434\u0435\u0442\u0441\u043A\u0438\u0435).
    \u0421\u0442\u0430\u0440\u0448\u0430\u044F \u0434\u0440\u0443\u0436\u0438\u043D\u0430
    \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u0430 \u0432 \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0438
    \u043A\u043D\u044F\u0436\u0435\u0441\u0442\u0432\u043E\u043C, \u043C\u043B\u0430\u0434\u0448\u0430\u044F
    \u043D\u0435\u0441\u043B\u0430 \u0432\u043E\u0435\u043D\u043D\u0443\u044E \u0441\u043B\u0443\u0436\u0431\u0443.
    \u0412 \u043F\u043E\u0445\u043E\u0434\u0430\u0445 \u0443\u0447\u0430\u0441\u0442\u0432\u043E\u0432\u0430\u043B\u043E
    \u0438 \u043D\u0430\u0440\u043E\u0434\u043D\u043E\u0435 \u043E\u043F\u043E\u043B\u0447\u0435\u043D\u0438\u0435
    - \u0432\u043E\u0438.\" \u0418\u0441\u0442\u043E\u0440\u0438\u0447\u0435\u0441\u043A\u0430\u044F
    \u0441\u043F\u0440\u0430\u0432\u043A\u0430: \u041D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435
    \u0430\u0440\u0445\u0435\u043E\u043B\u043E\u0433\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u043D\u0430\u0445\u043E\u0434\u043E\u043A \u0432 \u041D\u043E\u0432\u0433\u043E\u0440\u043E\u0434\u0435
    \u0438 \u0434\u0430\u043D\u043D\u044B\u0445 \u0438\u0437 \"\u0420\u0443\u0441\u0441\u043A\u043E\u0439
    \u041F\u0440\u0430\u0432\u0434\u044B\"."
